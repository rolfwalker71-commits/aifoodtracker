generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String?
  passwordHash       String
  openAiApiKey       String?
  avatarPath         String?
  sex                Sex?
  heightCm           Float?
  weightKg           Float?
  birthYear          Int?
  activityLevel      ActivityLevel  @default(MODERATE)
  autoCalculateGoals Boolean        @default(true)
  dailyCaloriesGoal  Float          @default(2000)
  dailyProteinGoal   Float          @default(150)
  dailyCarbsGoal     Float          @default(200)
  dailyFatGoal       Float          @default(65)
  dailyFiberGoal     Float          @default(30)
  dailySugarGoal     Float          @default(50)
  dailySodiumGoal    Float          @default(2300)
  dailyPotassiumGoal Float          @default(3400)
  dailyVitaminAGoal  Float          @default(900)
  dailyVitaminCGoal  Float          @default(90)
  dailyVitaminDGoal  Float          @default(20)
  dailyCalciumGoal   Float          @default(1000)
  dailyIronGoal      Float          @default(8)
  /// [{ id, mealType, timeLocal "HH:mm", enabled }]
  reminders          Json?
  themePreference    String         @default("system")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  meals              Meal[]
  apiAccessKeys      ApiAccessKey[]
  accounts           Account[]
  sessions           Session[]
}

/// NutriSight REST API access key (plaintext shown once; only hash stored)
model ApiAccessKey {
  id         String    @id @default(cuid())
  userId     String
  name       String    @default("Standard")
  /// Display prefix, e.g. "ns_a1b2c3d4"
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Meal {
  id           String   @id @default(cuid())
  userId       String
  name         String
  imagePath    String?
  portionSize  String?
  /// AI-erkannte Hauptzutaten [{ name, portionSize, grams? }]
  ingredients  Json?
  calories     Float    @default(0)
  protein      Float    @default(0)
  carbs        Float    @default(0)
  fat          Float    @default(0)
  fiber        Float    @default(0)
  sugar        Float    @default(0)
  saturatedFat Float    @default(0)
  sodium       Float    @default(0)
  potassium    Float    @default(0)
  vitaminA     Float    @default(0)
  vitaminC     Float    @default(0)
  vitaminD     Float    @default(0)
  calcium      Float    @default(0)
  iron         Float    @default(0)
  mealType     MealType @default(SNACK)
  isFavorite   Boolean  @default(false)
  notes        String?
  consumedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([userId, mealType])
  @@index([userId, isFavorite])
}
