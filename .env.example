# Database
DATABASE_URL="postgresql://aifood:aifood@localhost:5432/aifoodtracker?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Encrypts per-user OpenAI API keys at rest
ENCRYPTION_KEY="32-byte-hex-or-passphrase-change-me"

# Optional fallback if a user has no personal key
OPENAI_API_KEY=""
